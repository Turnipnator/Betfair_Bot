.git
.gitignore
*.pyc
__pycache__
.env.example
*.md
.vscode
.idea
data/logs/*
data/*.db
!data/.gitkeep
.pytest_cache
.mypy_cache
.ruff_cache

# Secrets and certs are supplied at run time (env_file + the certs volume).
# Without these two lines `COPY . .` bakes them into every image layer.
.env
certs/
